{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts", "../src/**/*.ts", "**/packages/cli/src/**/*.ts"],
  "allow-external": true,
  "exclude-after-remap": true,
  "check-coverage": true,
  "lines": 98,
  "statements": 98,
  "reporter": ["text", "html", "lcovonly", "json-summary"],
  "reports-dir": "coverage",
  "temp-directory": "coverage/tmp"
}
